# Copy this file to .env.local and fill in the values from
# Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration.
# .env.local is git-ignored. These values are not secret (they identify the project, they don't
# grant access) — Firestore security rules are what protect the data — but keep them out of git anyway.
#
# Leave them empty to run the app without sign-in, with data stored only in this browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to use the local Firebase emulators (npx firebase emulators:start) instead of the real project.
VITE_FIREBASE_USE_EMULATORS=
