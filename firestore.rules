rules_version = '2';

// Data model
//   users/{uid}                         profile of one signed-in person (only they can read/write it)
//   households/{householdId}            a shared budget: { name, owner, members: [uid, ...] }
//   households/{householdId}/{col}/{id} everything in that budget (transactions, categories, budgets, rules, imports)
// Only members of a household can read or change anything inside it. Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function household(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId)).data;
    }

    function isMember(householdId) {
      return signedIn() && request.auth.uid in household(householdId).members;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /households/{householdId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      // You can only create a household that you own and are the only member of.
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      // Only the owner can rename it or change who is in it, and the owner can't be removed.
      allow update: if signedIn()
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner
        && request.auth.uid in request.resource.data.members;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      match /{collection}/{docId} {
        allow read, write: if isMember(householdId);
      }
    }
  }
}
